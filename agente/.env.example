# ============================================================================
# Agente 10.0.3.8 — .env.example
# Copiar a .env y completar. NUNCA subir .env con credenciales reales (§35).
# ============================================================================

# Backend al que reporta el agente. En producción SIEMPRE https:// (§38).
API_BASE_URL=http://localhost:8000

# API key del agente '<AgenteId>.<secreto>' (se genera en POST /api/v1/agentes).
AGENT_API_KEY=

# Override de la carpeta origen (simulación local). En 10.0.3.8 déjalo VACÍO:
# el agente usa la RutaOrigen del catálogo (G:\TempRespSQLServer).
AGENT_ORIGEN_DIR=

# Fecha operativa override para pruebas (ej. AGENT_FECHA=2026-08-11).
AGENT_FECHA=

# Sufijos de archivo considerados respaldos.
AGENT_MATCH_SUFIJOS=.bak,.BAK

# Login de solo lectura en msdb (SQLAgentReaderRole). Completar fuera del chat.
SQL_JOBS_USER=
SQL_JOBS_PASSWORD=

# --- Red (reintentos §13) ---
HTTP_TIMEOUT=15
HTTP_RETRIES=3
HTTP_RETRY_DELAY=5

LOG_LEVEL=INFO

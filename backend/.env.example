# ============================================================================
# MONITOREO_SOPORTE — Backend .env.example
# Copiar a .env y completar. NUNCA subir .env con credenciales reales (§35).
# ============================================================================

# --- Aplicación ---
APP_NAME=MONITOREO_SOPORTE API
APP_ENV=development                    # development | production
APP_HOST=0.0.0.0
APP_PORT=8000
LOG_LEVEL=INFO
CORS_ORIGINS=http://localhost:3000     # separadas por coma

# --- Base de datos MONITOREO_SOPORTE (SQL Server 2019, prod: 10.0.3.8) ---
# Conexión vía pyodbc. El driver ODBC debe estar instalado en el equipo.
DB_HOST=10.0.3.8
DB_PORT=1433
DB_NAME=MONITOREO_SOPORTE
DB_USER=sa
DB_PASSWORD=
DB_DRIVER=ODBC Driver 18 for SQL Server
DB_TRUST_SERVER_CERTIFICATE=yes

# --- Base SEGURIDAD_PROSUR (solo lectura, para autenticación §22) ---
SEGURIDAD_HOST=10.0.3.8
SEGURIDAD_PORT=1433
SEGURIDAD_DB=SEGURIDAD_PROSUR
SEGURIDAD_USER=sa
SEGURIDAD_PASSWORD=
SEGURIDAD_DRIVER=ODBC Driver 18 for SQL Server
SEGURIDAD_TRUST_SERVER_CERTIFICATE=yes

# --- Autenticación (JWT) ---
JWT_SECRET=change-me-por-un-secreto-largo-y-aleatorio
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=480
AUTH_MODE=stub                        # stub (desarrollo) | seguridad (SEGURIDAD_PROSUR)

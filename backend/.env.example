# ============================================================================
# MONITOREO_SOPORTE — Backend .env.example
# Copiar a .env y completar. NUNCA subir .env con credenciales reales (§35).
# ============================================================================

# --- Aplicación ---
APP_NAME=MONITOREO_SOPORTE API
APP_ENV=development                    # development | production
APP_HOST=0.0.0.0
APP_PORT=8000
LOG_LEVEL=INFO
CORS_ORIGINS=http://localhost:3000     # separadas por coma

# --- TLS / HTTPS (§38) ---
# IMPORTANTE: la X-Agent-Key viaja en el header. La VPN cifra entre redes,
# pero DENTRO de la red el header viaja en claro sin TLS. En producción los
# agentes deben llamar SIEMPRE a https://<host> y aquí van los archivos del cert.
# En desarrollo (loopback/VPN) pueden quedar vacíos.
SSL_CERTFILE=
SSL_KEYFILE=

# --- Base de datos MONITOREO_SOPORTE (SQL Server 2019, prod: 192.168.6.5) ---
# Opción A (recomendada para LocalDB/instancias con nombres complejos):
# connection string ODBC completa. Tiene prioridad sobre la opción B.
# El Driver= se inyecta desde DB_DRIVER si la string no lo incluye.
DB_ODBC_CONNECT=

# Opción B: componentes individuales (host/port/db/user/pass).
DB_HOST=192.168.6.5
DB_PORT=1433
DB_NAME=MONITOREO_SOPORTE
DB_USER=sa
DB_PASSWORD=
DB_DRIVER=ODBC Driver 18 for SQL Server
DB_TRUST_SERVER_CERTIFICATE=yes

# --- Base SEGURIDAD_PROSUR (solo lectura, §22) ---
SEGURIDAD_HOST=192.168.6.5
SEGURIDAD_PORT=1433
SEGURIDAD_DB=SEGURIDAD_PROSUR
SEGURIDAD_USER=sa
SEGURIDAD_PASSWORD=
SEGURIDAD_DRIVER=ODBC Driver 18 for SQL Server
SEGURIDAD_TRUST_SERVER_CERTIFICATE=yes

# --- Autenticación (JWT) ---
JWT_SECRET=change-me-por-un-secreto-largo-y-aleatorio
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=480
AUTH_MODE=stub                        # stub (desarrollo) | seguridad (producción)

# --- Disco Checker (§33): umbrales globales de espacio libre (%, misma política todas las unidades) ---
DISK_WARNING_PCT=20
DISK_ERROR_PCT=10

# --- Alertas por correo (§28) — SMTP ---
# Las credenciales viven SOLO en el .env (nunca en el chat ni en el repo).
# Si SMTP_HOST queda vacio, el envio asincrono marca la alerta FALLIDA con
# detalle; se reintenta posteriormente mediante el endpoint de alertas.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
SMTP_TLS=true                       # STARTTLS; false solo para SMTP de prueba local
SMTP_TIMEOUT=15
ALERTA_ROL_DESTINATARIOS=SOPORTE    # rol cuyos usuarios activos reciben alertas
